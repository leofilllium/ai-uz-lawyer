# AI Lawyer - Environment Variables

# Database
POSTGRES_PASSWORD=your-secure-password-here

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API (for embeddings)
OPENAI_API_KEY=your-openai-api-key

# Claude Models (optional, these are defaults)
CLAUDE_OPUS_MODEL=claude-sonnet-4-20250514
CLAUDE_HAIKU_MODEL=claude-3-5-haiku-latest
THINKING_BUDGET_TOKENS=10000

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Security
RATE_LIMIT_ENABLED=true
ALLOWED_ORIGINS=https://lawyerai.uz,https://api.lawyerai.uz,http://localhost:3000
