.env.local
.env.*.local
*.env.local

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── Backend (Python / FastAPI) ───────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.venv/
backend/venv/
backend/env/
backend/ENV/
backend/*.egg-info/
backend/.eggs/
backend/dist/
backend/sdist/
backend/wheels/
backend/.installed.cfg
backend/*.egg
backend/data/chroma_db/
backend/app/test/chunks/
