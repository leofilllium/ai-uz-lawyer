# ─── Frontend (React / Vite) ──────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ─── Mobile (Flutter / Dart) ─────────────────────────────────────────────────
# Generated & tool files (complement mobile/.gitignore)
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.dart_tool/
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/coverage/

# Android signing (never commit keystores)
mobile/android/key.properties
mobile/android/**/*.keystore
mobile/android/**/*.jks
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/captures/
mobile/android/.cxx/

# iOS build artifacts
mobile/ios/Pods/
mobile/ios/DerivedData/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_assets/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/ServiceDefinitions.json
mobile/ios/Runner/GeneratedPluginRegistrant.*

# ─── Infrastructure / Docker ──────────────────────────────────────────────────
postgres_data/
chroma_data/
certbot/conf/
certbot/www/

# ─── Logs ─────────────────────────────────────────────────────────────────────
